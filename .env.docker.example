# SYSTEM PRO — Docker development (Path B: PostgreSQL via Docker Compose)
# Copy to .env when using Compose for the database:
#   copy .env.docker.example .env   (Windows cmd)
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
# Inside Docker network the host is the service name; from the Windows host
# (API on host + DB in Docker) keep localhost via the published port.
# Host-side API -> Docker DB:
DATABASE_URL=postgresql://systempro:CHANGE_ME_DEV_ONLY@localhost:5432/systempro_dev
# If the API itself ever runs inside Compose, use:
# DATABASE_URL=postgresql://systempro:CHANGE_ME_DEV_ONLY@postgres:5432/systempro_dev
APP_VERSION=0.1.0
GIT_COMMIT=unknown
POSTGRES_DB=systempro_dev
POSTGRES_USER=systempro
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY
POSTGRES_PORT=5432
