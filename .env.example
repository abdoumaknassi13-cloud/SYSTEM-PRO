# SYSTEM PRO — local development (Path A: PostgreSQL directly on Windows)
# Copy to .env (never commit .env):
#   copy .env.example .env   (Windows cmd)
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
# Local PostgreSQL running directly on this machine:
DATABASE_URL=postgresql://systempro:CHANGE_ME_DEV_ONLY@localhost:5432/systempro_dev
APP_VERSION=0.1.0
GIT_COMMIT=unknown
# Compose knobs (used only for Path B):
POSTGRES_DB=systempro_dev
POSTGRES_USER=systempro
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY
POSTGRES_PORT=5432
